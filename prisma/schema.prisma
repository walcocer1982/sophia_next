// Sophia Database Schema
// Versión: 2.0.0
// PostgreSQL (Neon) + NextAuth v5 (JWT strategy)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 1. AUTENTICACIÓN Y USUARIOS
// ============================================

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  SUPERADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  googleId      String?   @unique
  avatar        String?
  // ── Datos oficiales del padrón académico (importados, no autodeclarados) ──
  // El DNI es la llave del padrón: es lo que aparece en el reporte de notas y
  // lo que el líder usa para armar las listas de tutoría.
  dni                String? @unique
  // Correo institucional (e202620153@estudiantes.cetemin.edu.pe). Hoy el alumno
  // entra con su correo personal (`email`); cuando migren a Microsoft entrará
  // con este, y hay que reconocerlo como el mismo usuario.
  institutionalEmail String? @unique
  // Celular de WhatsApp — el circuito de seguimiento del Objetivo 3.
  phone              String?
  // Grupo del padrón dentro de su carrera y sede («1», «2»…). Es lo que
  // determina a qué sección va cuando se agrega un curso a su carrera.
  academicSection    String?
  role          UserRole  @default(STUDENT)
  careerId      String?
  // Sede de pertenencia (opcional — superadmins pueden no tener sede)
  sedeId        String?
  // Admisión del estudiante (período académico en que ingresó, ej: "2026-1").
  // Se elige en el onboarding y filtra las secciones visibles a su cohorte.
  admissionPeriodId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  career             Career?              @relation(fields: [careerId], references: [id])
  sede               Sede?                @relation(fields: [sedeId], references: [id])
  admissionPeriod    AcademicPeriod?      @relation(fields: [admissionPeriodId], references: [id])
  lessonSessions     LessonSession[]
  accounts           Account[]
  courses            Course[]
  sectionInstructors SectionInstructor[]
  enrollments        Enrollment[]

  @@index([email])
  @@index([googleId])
  @@index([dni])
  @@index([careerId])
  @@index([sedeId])
  @@index([admissionPeriodId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================
// 2. CARRERAS / PROGRAMAS
// ============================================

// Career = Programa académico. Se mantiene el nombre "Career" en el schema
// para no romper código existente, pero conceptualmente es "Programa"
// (Inducción Académica, ENTER, etc.). En UI se renombrará gradualmente.
model Career {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  // Código corto oficial CETEMIN (EOM, PM, SI, MMP, MSEII). Opcional —
  // los programas no académicos (Inducción, ENTER) pueden no tenerlo.
  code      String?  @unique
  createdAt DateTime @default(now())

  // Relaciones
  users   User[]
  // DEPRECADO: lado inverso de Course.careerId. Ver coursesShared.
  courses Course[]
  // m:n con Course: qué cursos sirven a esta carrera.
  coursesShared Course[] @relation("CourseCareers")
  // m:n con Sede: en qué sedes se dicta esta carrera.
  // Ej: EOM se dicta en ABQ + FCHB, PM solo en ABQ.
  sedes   Sede[]   @relation("CareerSedes")
}

// ============================================
// 2.5 SEDES (campus físicos + virtuales)
// ============================================

model Sede {
  id        String   @id @default(cuid())
  code      String   @unique  // "ABQ", "IRQ", "FCHB", "ENTER"
  name      String            // "Alberto Benavides de la Quintana"
  city      String?
  address   String?
  isVirtual Boolean  @default(false)  // ENTER = true, físicas = false
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relaciones
  courses  Course[]  @relation("CourseSedes")  // m:n con cursos
  careers  Career[]  @relation("CareerSedes")  // m:n con carreras (qué carreras se dictan acá)
  sections Section[]
  users    User[]

  @@index([code])
}

// ============================================
// 3. CONTENIDO EDUCATIVO
// ============================================

enum CourseMethodology {
  REFLECTIVE // Actividades + verificación socrática (default)
  CODE       // Instrucciones paso a paso + verificación binaria
}

enum CourseScope {
  TRANSVERSAL    // Se dicta en TODAS las sedes que ofrecen carreras
                 // (Empleabilidad, Plan de Tutoría, Inducción, Inglés básico).
                 // No pertenece a una carrera específica.
  SPECIALIZATION // Específico de UNA carrera (EOM, PM, etc.).
                 // Pertenece a la carrera + se dicta en las sedes de esa carrera.
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  capacidad   String?  @db.Text  // Competencia general del curso
  instructor  String   @db.Text  // Personalidad del AI instructor
  userId      String?            // Instructor que creó el curso
  careerId    String?            // Programa académico (Career = Programa)
  voiceEnabled Boolean @default(true)  // Si false, el chat del curso oculta el botón de voz
  // Scope: alcance del curso dentro del plan académico
  //  - TRANSVERSAL: se dicta en todas las sedes (no requiere carrera).
  //  - SPECIALIZATION: específico de la carrera asignada (careerId).
  scope       CourseScope @default(SPECIALIZATION)
  // Metodología pedagógica del curso (todas sus lecciones la heredan):
  //  - REFLECTIVE: actividades con prompt de instrucción + verificación socrática (default actual)
  //  - CODE: instrucciones paso a paso, verificación binaria (hizo/no hizo), sin rúbrica de comprensión
  methodology     CourseMethodology @default(REFLECTIVE)
  allowPaste      Boolean @default(false)  // Permitir pegar texto en el chat del estudiante
  allowImagePaste Boolean @default(false)  // Permitir pegar/adjuntar imágenes en el chat del estudiante
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relaciones
  user     User?     @relation(fields: [userId], references: [id])
  // DEPRECADO: una sola carrera por curso. Se conserva mientras se migran los
  // lectores a `careers`; ver careers[] abajo.
  career   Career?   @relation(fields: [careerId], references: [id])
  // Un curso puede servir a VARIAS carreras (m:n) — la malla de EOM y la de PM
  // pueden compartir el mismo curso sin duplicarlo. Con scope TRANSVERSAL la
  // lista se ignora: sirve a todas las carreras, incluidas las que no existen
  // todavía (por eso conviene el flag y no listar las nueve a mano).
  careers  Career[]  @relation("CourseCareers")
  lessons  Lesson[]
  sections Section[]
  // Un curso puede ofrecerse en VARIAS sedes (m:n).
  sedes    Sede[]    @relation("CourseSedes")

  @@index([slug])
  @@index([userId])
  @@index([careerId])
  @@index([scope])
  @@index([deletedAt])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  objective   String   // Objetivo de la lección
  keyPoints   String[] // Puntos clave de la lección
  contentJson Json     // { moments: [...] }
  videoUrl    String?   // URL del video animado de Sophia (panel lateral durante la clase)
  order       Int       @default(0)
  isPublished      Boolean   @default(false)
  availableAt      DateTime? // Fecha/hora desde la cual está disponible para estudiantes
  closesAfterHours Int       @default(3) // Horas después de availableAt para cerrar la sesión
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relaciones
  courseId          String
  course            Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions          LessonSession[]
  sectionSchedules  SectionLessonSchedule[]

  @@index([slug])
  @@index([courseId])
}

// ============================================
// 3. APRENDIZAJE
// ============================================

enum Language {
  ES // Español (default)
  EN // English (kiosko internacional / ferias)
}

model LessonSession {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  enrolledAt     DateTime  @default(now())
  sessionAttempt Int       @default(1)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  lastActivityAt DateTime  @default(now())
  activityId     String?   // Referencia a contentJson.activities[].id
  summaryText    String?   @db.Text
  lastSummaryAt  DateTime?
  // Propuesta de proyecto acordada con el estudiante en la sesión-bisagra
  // (cursos de metodología CODE basados en proyecto personal del estudiante).
  // Una vez fijada, se inyecta como contexto en las actividades posteriores.
  projectBrief   Json?
  isTest         Boolean   @default(false)
  sectionId      String?   // Snapshot de la sección al iniciar sesión
  progress       Float     @default(0)
  grade          Float?
  completedAt    DateTime?
  passed         Boolean   @default(false)
  // Idioma de la sesión. En kiosko se setea en el registro (toggle ES/EN).
  // En /learn queda ES por default. Se pasa al system prompt de Claude y
  // al TTS para que Sophia responda en el idioma elegido.
  language       Language  @default(ES)

  // Relaciones
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  messages   Message[]
  activities ActivityProgress[]
  survey     LessonSurvey?

  @@unique([userId, lessonId, sessionAttempt])
  @@index([userId])
  @@index([lessonId])
  @@index([sectionId])
}

// ============================================
// 3.5 ENCUESTA NPS POST-LECCIÓN
// ============================================

enum SurveyUtility {
  VERY_USEFUL    // "Muy útil — voy a usarlo"
  USEFUL         // "Útil — algo me va a servir"
  LOW_USEFUL     // "Poco útil — no sé cuándo lo usaré"
  NOT_USEFUL     // "Nada útil — no me sirve"
}

model LessonSurvey {
  id          String        @id @default(cuid())
  sessionId   String        @unique  // 1 encuesta por sesión, sin duplicados
  npsScore    Int                    // 1-10 (variante sin 0)
  npsReason   String?       @db.Text // texto libre opcional, max ~300 chars
  utility     SurveyUtility          // self-reported utilidad práctica
  language    Language      @default(ES) // Idioma en que se respondió la encuesta
  submittedAt DateTime      @default(now())

  session LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([npsScore])
  @@index([submittedAt])
}

enum ActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

model ActivityProgress {
  id              String         @id @default(cuid())
  lessonSessionId String
  activityId      String         // Referencia a contentJson.activities[].id
  status          ActivityStatus @default(NOT_STARTED)
  startedAt       DateTime?
  completedAt     DateTime?
  evidenceData    Json?
  verifiedBy      String?
  passedCriteria  Boolean        @default(false)
  aiFeedback      String?        @db.Text
  attempts        Int            @default(0)
  tangentCount    Int            @default(0) // Track off-topic question count

  // Relaciones
  lessonSession LessonSession @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)

  @@unique([lessonSessionId, activityId])
  @@index([lessonSessionId])
  @@index([status])
}

model Message {
  id           String   @id @default(cuid())
  sessionId    String
  role         String
  content      String   @db.Text
  timestamp    DateTime @default(now())
  activityId   String?  // Referencia a contentJson.activities[].id
  inputTokens  Int?
  outputTokens Int?

  // Relaciones
  session LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

// ============================================
// 4. PERIODOS ACADÉMICOS Y SECCIONES
// ============================================

model AcademicPeriod {
  id        String   @id @default(cuid())
  name      String   @unique // "2025-1", "2025-2", "2026-1"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  sections      Section[]
  admittedUsers User[]
}

model Section {
  id        String   @id @default(cuid())
  name      String   // "Salón A", "Salón B"
  courseId   String
  periodId  String
  // Sede física donde se dicta esta sección. Opcional inicialmente para no
  // romper data legacy; el plan es hacerlo obligatorio una vez asignadas
  // todas las sedes a las secciones existentes via script.
  sedeId    String?
  // Fechas reales de dictado de esta cohort dentro del período académico.
  // Útil para cursos cortos (2-4 sem) que viven dentro de un ciclo de 12 sem.
  // Opcional para no romper datos legacy. Cuando ambos están presentes,
  // permite ordenar por inicio y archivar automáticamente las terminadas.
  startDate DateTime?
  endDate   DateTime?
  // Sección archivada = read-only histórico. La cohort terminó, los datos
  // se conservan pero no se permiten más mutaciones. Independiente del
  // período: un período activo puede tener secciones archivadas si esa
  // cohort acabó antes que las demás del mismo período.
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt DateTime  @default(now())

  course      Course                  @relation(fields: [courseId], references: [id])
  period      AcademicPeriod          @relation(fields: [periodId], references: [id])
  sede        Sede?                   @relation(fields: [sedeId], references: [id])
  instructors SectionInstructor[]
  enrollments Enrollment[]
  schedules   SectionLessonSchedule[]

  // NOTA: no usamos @@unique sobre (courseId, periodId, name) porque romperia
  // el caso normal de cohorts cíclicas: archivás "Junio 2025-A" y luego querés
  // crear "Junio 2026-A" — el archivado seguiría reservando el slot. La unicidad
  // se valida en el endpoint POST solo contra secciones no archivadas.
  @@index([courseId, periodId, name])
  @@index([courseId])
  @@index([periodId])
  @@index([sedeId])
  @@index([isArchived])
}

model SectionInstructor {
  id        String   @id @default(cuid())
  userId    String
  sectionId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  sectionId  String
  enrolledAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
}

model SectionLessonSchedule {
  id               String    @id @default(cuid())
  sectionId        String
  lessonId         String
  availableAt      DateTime?
  closesAfterHours Int       @default(3)

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([sectionId, lessonId])
  @@index([sectionId])
  @@index([lessonId])
}
