# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local

# Keep example env
!.env.example

# Claude development files
CLAUDE.md
CLAUDE.md.backup
TODOS.md
FLOWS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Local-only media sources (uploaded to Cloudinary, too large for git)
Informacion/videos/

# Claude harness internal
.claude/scheduled_tasks.lock

# investigación interna (no subir)
investigacion/

# Avatares 3D de experimentación (119 MB). Ninguno está referenciado por la app
# —el kiosko carga el modelo desde readyplayer.me— y meterlos infla el repo
# para siempre. Viven en la máquina de quien experimenta.
public/talkinghead/avatars/

# Lienzos de diseño: se versionan las fuentes .dc.html y canvas.json (288 KB),
# no el archivo publicado, que pesa 2.6 MB cada uno y se regenera con el helper.
design-*/*.html
!design-*/*.dc.html

# Salida de corridas locales
logs/
